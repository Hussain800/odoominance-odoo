<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_food_safety" model="ir.module.category">
            <field name="name">Food Safety</field>
            <field name="sequence">45</field>
        </record>

        <record id="res_groups_privilege_food_safety" model="res.groups.privilege">
            <field name="name">Food Safety</field>
            <field name="category_id" ref="module_category_food_safety"/>
        </record>

        <record id="group_food_safety_inspector" model="res.groups">
            <field name="name">Inspector</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_food_safety"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can create and execute food safety inspections.</field>
        </record>

        <record id="group_food_safety_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_food_safety"/>
            <field name="implied_ids" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_inspector'))]"/>
            <field name="comment">Can review inspections and approve or reject outcomes.</field>
        </record>

        <record id="group_food_safety_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_food_safety"/>
            <field name="implied_ids" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_supervisor'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access to food safety configuration and records.</field>
        </record>

        <record id="inspection_rule_company" model="ir.rule">
            <field name="name">Food Safety Inspection Company Rule</field>
            <field name="model_id" ref="model_dm_food_inspection"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="inspection_rule_inspector" model="ir.rule">
            <field name="name">Food Safety Inspection Inspector Rule</field>
            <field name="model_id" ref="model_dm_food_inspection"/>
            <field name="domain_force">['|', ('inspector_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_inspector'))]"/>
        </record>

        <record id="inspection_rule_supervisor" model="ir.rule">
            <field name="name">Food Safety Inspection Supervisor Rule</field>
            <field name="model_id" ref="model_dm_food_inspection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_supervisor'))]"/>
        </record>

        <record id="inspection_rule_manager" model="ir.rule">
            <field name="name">Food Safety Inspection Manager Rule</field>
            <field name="model_id" ref="model_dm_food_inspection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_manager'))]"/>
        </record>

        <record id="template_rule_company" model="ir.rule">
            <field name="name">Food Safety Template Company Rule</field>
            <field name="model_id" ref="model_dm_food_checklist_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="template_line_rule_company" model="ir.rule">
            <field name="name">Food Safety Template Line Company Rule</field>
            <field name="model_id" ref="model_dm_food_checklist_template_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="stage_rule_company" model="ir.rule">
            <field name="name">Food Safety Stage Company Rule</field>
            <field name="model_id" ref="model_dm_food_inspection_stage"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="grade_rule_company" model="ir.rule">
            <field name="name">Food Safety Grade Company Rule</field>
            <field name="model_id" ref="model_dm_food_inspection_grade"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="finding_rule_company" model="ir.rule">
            <field name="name">Food Safety Finding Company Rule</field>
            <field name="model_id" ref="model_dm_food_finding"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="finding_rule_inspector" model="ir.rule">
            <field name="name">Food Safety Finding Inspector Rule</field>
            <field name="model_id" ref="model_dm_food_finding"/>
            <field name="domain_force">['|', ('inspection_id.inspector_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_inspector'))]"/>
        </record>

        <record id="finding_rule_supervisor" model="ir.rule">
            <field name="name">Food Safety Finding Supervisor Rule</field>
            <field name="model_id" ref="model_dm_food_finding"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_supervisor'))]"/>
        </record>

        <record id="finding_rule_manager" model="ir.rule">
            <field name="name">Food Safety Finding Manager Rule</field>
            <field name="model_id" ref="model_dm_food_finding"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_manager'))]"/>
        </record>

        <record id="certificate_rule_company" model="ir.rule">
            <field name="name">Food Safety Certificate Company Rule</field>
            <field name="model_id" ref="model_dm_food_certificate"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="certificate_rule_inspector" model="ir.rule">
            <field name="name">Food Safety Certificate Inspector Rule</field>
            <field name="model_id" ref="model_dm_food_certificate"/>
            <field name="domain_force">['|', ('inspection_id.inspector_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_inspector'))]"/>
        </record>

        <record id="certificate_rule_supervisor" model="ir.rule">
            <field name="name">Food Safety Certificate Supervisor Rule</field>
            <field name="model_id" ref="model_dm_food_certificate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_supervisor'))]"/>
        </record>

        <record id="certificate_rule_manager" model="ir.rule">
            <field name="name">Food Safety Certificate Manager Rule</field>
            <field name="model_id" ref="model_dm_food_certificate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dm_food_safety_inspection.group_food_safety_manager'))]"/>
        </record>

        <record id="violation_tag_rule_company" model="ir.rule">
            <field name="name">Food Safety Violation Tag Company Rule</field>
            <field name="model_id" ref="model_dm_food_violation_tag"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
