<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dm_food_safety_stage_draft" model="dm.food.inspection.stage">
            <field name="name">Draft</field>
            <field name="code">draft</field>
            <field name="sequence">1</field>
            <field name="color">0</field>
        </record>
        <record id="dm_food_safety_stage_ready" model="dm.food.inspection.stage">
            <field name="name">Ready</field>
            <field name="code">ready</field>
            <field name="sequence">10</field>
            <field name="color">2</field>
        </record>
        <record id="dm_food_safety_stage_in_progress" model="dm.food.inspection.stage">
            <field name="name">In Progress</field>
            <field name="code">in_progress</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
        </record>
        <record id="dm_food_safety_stage_waiting_supervisor" model="dm.food.inspection.stage">
            <field name="name">Waiting Supervisor</field>
            <field name="code">waiting_supervisor</field>
            <field name="sequence">30</field>
            <field name="requires_supervisor">1</field>
            <field name="color">4</field>
        </record>
        <record id="dm_food_safety_stage_passed" model="dm.food.inspection.stage">
            <field name="name">Passed</field>
            <field name="code">passed</field>
            <field name="sequence">40</field>
            <field name="fold">1</field>
            <field name="done">1</field>
            <field name="color">10</field>
        </record>
        <record id="dm_food_safety_stage_failed" model="dm.food.inspection.stage">
            <field name="name">Failed</field>
            <field name="code">failed</field>
            <field name="sequence">50</field>
            <field name="fold">1</field>
            <field name="done">1</field>
            <field name="color">1</field>
        </record>
        <record id="dm_food_safety_stage_cancelled" model="dm.food.inspection.stage">
            <field name="name">Cancelled</field>
            <field name="code">cancelled</field>
            <field name="sequence">60</field>
            <field name="fold">1</field>
            <field name="done">1</field>
            <field name="color">8</field>
        </record>
    </data>
</odoo>
