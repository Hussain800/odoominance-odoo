<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_dm_food_violation_tag_search" model="ir.ui.view">
            <field name="name">dm.food.violation.tag.search</field>
            <field name="model">dm.food.violation.tag</field>
            <field name="arch" type="xml">
                <search string="Violation Tags">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_dm_food_violation_tag_list" model="ir.ui.view">
            <field name="name">dm.food.violation.tag.list</field>
            <field name="model">dm.food.violation.tag</field>
            <field name="arch" type="xml">
                <list string="Violation Tags" sample="1" default_order="name">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color" widget="color_picker"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_dm_food_violation_tag_form" model="ir.ui.view">
            <field name="name">dm.food.violation.tag.form</field>
            <field name="model">dm.food.violation.tag</field>
            <field name="arch" type="xml">
                <form string="Violation Tag">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_dm_food_violation_tag" model="ir.actions.act_window">
            <field name="name">Violation Tags</field>
            <field name="res_model">dm.food.violation.tag</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_dm_food_violation_tag_search"/>
            <field name="path">food-safety-violation-tags</field>
        </record>

        <menuitem id="menu_dm_food_safety_violation_tags" name="Violation Tags"
            parent="menu_dm_food_safety_config" action="action_dm_food_violation_tag" sequence="40"
            groups="dm_food_safety_inspection.group_food_safety_supervisor"/>
    </data>
</odoo>
