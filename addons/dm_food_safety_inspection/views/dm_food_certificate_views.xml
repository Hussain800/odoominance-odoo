<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_dm_food_certificate_search" model="ir.ui.view">
            <field name="name">dm.food.certificate.search</field>
            <field name="model">dm.food.certificate</field>
            <field name="arch" type="xml">
                <search string="Food Safety Certificates">
                    <field name="name"/>
                    <field name="inspection_id"/>
                    <field name="establishment_id"/>
                    <field name="status"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="Expired" name="expired" domain="[('is_expired', '=', True)]"/>
                    <filter string="Revoked" name="revoked" domain="[('status', '=', 'revoked')]"/>
                    <group>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Inspection" name="group_inspection" context="{'group_by': 'inspection_id'}"/>
                        <filter string="Establishment" name="group_establishment" context="{'group_by': 'establishment_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_dm_food_certificate_list" model="ir.ui.view">
            <field name="name">dm.food.certificate.list</field>
            <field name="model">dm.food.certificate</field>
            <field name="arch" type="xml">
                <list string="Food Safety Certificates" sample="1" default_order="issue_date desc, id desc"
                    decoration-danger="is_expired"
                    decoration-muted="status == 'revoked'">
                    <field name="name"/>
                    <field name="inspection_id"/>
                    <field name="establishment_id" optional="hide"/>
                    <field name="status" widget="badge"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="is_expired" optional="hide"/>
                    <field name="inspector_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_dm_food_certificate_form" model="ir.ui.view">
            <field name="name">dm.food.certificate.form</field>
            <field name="model">dm.food.certificate</field>
            <field name="arch" type="xml">
                <form string="Food Safety Certificate">
                    <header>
                        <button name="action_mark_active" type="object" string="Activate" class="btn-primary"
                            invisible="status not in ['draft', 'expired']"/>
                        <button name="action_mark_expired" type="object" string="Expire" class="btn-secondary"
                            invisible="status in ['expired', 'revoked']"/>
                        <button name="action_mark_revoked" type="object" string="Revoke" class="btn-secondary"
                            invisible="status == 'revoked'"/>
                        <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-secondary"
                            invisible="status == 'draft'"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,active,expired,revoked"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="inspection_id"/>
                                <field name="establishment_id" readonly="1"/>
                                <field name="inspector_id" readonly="1" widget="many2one_avatar_user"/>
                            </group>
                            <group>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="is_expired" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_dm_food_certificate" model="ir.actions.act_window">
            <field name="name">Certificates</field>
            <field name="res_model">dm.food.certificate</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_dm_food_certificate_search"/>
            <field name="path">food-safety-certificates</field>
        </record>

        <menuitem id="menu_dm_food_safety_certificates" name="Certificates"
            parent="menu_dm_food_safety_root" action="action_dm_food_certificate" sequence="30"
            groups="dm_food_safety_inspection.group_food_safety_inspector"/>
    </data>
</odoo>
